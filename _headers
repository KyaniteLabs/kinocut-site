# Cloudflare Pages port of netlify.toml [[headers]] rules (2026-09-24).

/img/showcase/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Accept-Ranges: bytes

/img/showcase/*.mp4
  Content-Type: video/mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Accept-Ranges: bytes
  X-Content-Type-Options: nosniff

/img/showcase/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
